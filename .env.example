# Salin file ini menjadi .env lalu isi nilainya. File .env TIDAK ikut di-commit.

# Database PostgreSQL (di dalam Docker)
POSTGRES_DB=shigeru_hr
POSTGRES_USER=shigeru_hr
POSTGRES_PASSWORD=ganti-dengan-password-kuat

# Port aplikasi di laptop/server: http://localhost:3000
APP_PORT=3000

# Database kosong saat pertama jalan -> buat sheet standar + user admin bawaan.
SEED_ON_EMPTY=true

# Bridge ADMS (dulu: Script Properties di Apps Script)
ADMS_BRIDGE_URL=
ADMS_BRIDGE_KEY=
