# Salin menjadi C:\shigeru-hr\.env di VPS lalu isi nilainya.
# Password: pakai huruf dan angka saja (tanpa @ : / ? #), supaya DATABASE_URL tetap valid.

DATABASE_URL=postgres://shigeru_hr:GANTI_PASSWORD_DB@127.0.0.1:5432/shigeru_hr

# Hanya bisa diakses dari VPS itu sendiri; pengguna masuk lewat Apache (https://subdomain-hr).
HOST=127.0.0.1
PORT=3100

TZ=Asia/Jakarta

# Data dipindah dari laptop, jadi jangan buat data awal otomatis.
SEED_ON_EMPTY=false

# Bridge ADMS (dulu: Script Properties di Apps Script)
ADMS_BRIDGE_URL=
ADMS_BRIDGE_KEY=
